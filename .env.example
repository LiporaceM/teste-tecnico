# ---- Banco ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskmanager

# ---- API ----
# Mínimo de 32 caracteres (usado no modo local)
JWT_KEY=troque-esta-chave-em-producao-com-32-caracteres-ou-mais
SEED_DATA=true

# ---- Autenticação ----
# "local" (padrão: Identity + JWT, com contas de demonstração) ou "firebase"
AUTH_PROVIDER=local

# Somente para AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# E-mail que terá o perfil Admin (demais usuários são "User")
FIREBASE_ADMIN_EMAIL=
